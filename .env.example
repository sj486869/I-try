# ─── Server Config ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# ─── Storage ─────────────────────────────────────────────────────
# Where video files are stored. Can be an absolute path.
# Default: ./storage/videos (relative to server root)
STORAGE_DIR=./storage/videos

# ─── Security ────────────────────────────────────────────────────
# Optional. If set, all API requests must include:
#   Authorization: Bearer YOUR_SECRET_TOKEN
# Leave empty to allow open access (LAN / trusted network use).
AUTH_TOKEN=

# ─── CORS ────────────────────────────────────────────────────────
# Which origins can access this server.
# Use * for open access, or a specific origin like:
#   http://localhost:3000
#   https://your-webos-app.vercel.app
CORS_ORIGIN=*
